{
	"schemaVersion": 1,
	"id": "hotbar_layout_editor",
	"version": "${version}",
	"name": "Hotbar Layout Editor",
	"description": "Customize your Minecraft hotbar layout directly in game. Move each slot individually, move the whole hotbar as a group, hide GUI slots visually, and reposition the offhand slot.",
	"authors": ["tpcoffline"],
	"contact": { "homepage": "https://modrinth.com/mod/hotbar-layout-editor" },
	"license": "MIT",
	"icon": "assets/hotbar_layout_editor/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["com.craftea.hotbarlayout.HotbarLayoutMod"],
		"modmenu": ["com.craftea.hotbarlayout.ModMenuIntegration"]
	},
	"mixins": ["hotbar_layout_editor.mixins.json"],
	"depends": {
		"fabricloader": ">=0.19.5",
		"fabric-api": "*",
		"minecraft": "~26.3",
		"java": ">=25"
	},
	"suggests": { "modmenu": "*" },
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.modrinth": "https://modrinth.com/mod/hotbar-layout-editor"
			}
		}
	}
}